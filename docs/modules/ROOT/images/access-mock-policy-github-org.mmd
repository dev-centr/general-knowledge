  policy --> org["Include / match any<br/>GitHub organization is your-org<br/>optional: also a GitHub team"]
  login --> require["Require / optional, all must match<br/>GitHub organization is your-org"]
  org --> require
  require --> reuse["Save and reuse policy<br/>custom domain and pages.dev"]
  class policy primary
  class login,org secondary
  class require warning
  class reuse success
